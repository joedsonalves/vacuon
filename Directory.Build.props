<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <NeutralLanguage>pt-BR</NeutralLanguage>

    <!--
      Sem isto, `dotnet build Vacuon.sln` grava em bin\x64\... e
      `dotnet build src\Vacuon.Cli` grava em bin\... — e é fácil acabar
      executando um binário velho sem perceber.
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!--
      This file is read BEFORE the SDK gives Configuration its default. Without this
      line, `dotnet test tests\Vacuon.Core.Tests` with no -c built OutputPath from an
      empty Configuration and wrote to bin\net10.0-windows\, while `dotnet build -c Debug`
      wrote to bin\Debug\net10.0-windows\ - and a test run that skipped the build picked
      up the stale binaries in the other folder without a word. It happened on
      5 October 2026: the first test baseline of that session ran DLLs a month old.
    -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Vacuon</Product>
    <Company>Vacuon</Company>
    <Authors>Joedson</Authors>
    <Copyright>Copyright (c) 2026 Vacuon contributors</Copyright>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Server GC + PGO: o motor de varredura aloca em blocos grandes e vive de throughput. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
