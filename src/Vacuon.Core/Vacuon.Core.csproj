<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Vacuon.Core</RootNamespace>
    <AssemblyName>Vacuon.Core</AssemblyName>
    <!-- Núcleo sem WPF: a CLI, os testes e a futura GUI consomem exatamente isto. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vacuon.Native\Vacuon.Native.csproj" />
  </ItemGroup>

  <!-- Microsoft.Win32.Registry já vem no runtime quando o alvo é *-windows;
       referenciar o pacote só adiciona ruído de restore. -->

  <!--
    Dicionários de idioma embutidos: o assembly carrega sozinho, sem arquivo solto
    ao lado do .exe para o usuário perder.

    WithCulture="false" é OBRIGATÓRIO. "Strings.en-US.json" casa com o padrão
    nome.cultura.extensão, então o MSBuild infere a cultura e manda o arquivo para um
    assembly SATÉLITE (bin\en-US\Vacuon.Core.resources.dll) em vez do principal — e
    GetManifestResourceStream não acha nada, sem erro nenhum no build.
    LogicalName fixa o nome para não depender de RootNamespace nem do caminho.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings.en-US.json"
                      WithCulture="false"
                      LogicalName="Vacuon.Core.Localization.Strings.en-US.json" />
    <EmbeddedResource Include="Localization\Strings.pt-BR.json"
                      WithCulture="false"
                      LogicalName="Vacuon.Core.Localization.Strings.pt-BR.json" />
  </ItemGroup>

  <!--
    Catalogo de regras embutido. WithCulture="false" pelo mesmo motivo dos dicionarios:
    "catalog.json" nao casa com nome.cultura.extensao hoje, mas LogicalName fixa o nome
    independente de RootNamespace e de onde o arquivo esteja na arvore, que e o que evita
    o GetManifestResourceStream devolver null sem erro nenhum no build.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Cleanup\catalog.json"
                      WithCulture="false"
                      LogicalName="Vacuon.Core.Cleanup.catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vacuon.Core.Tests" />
  </ItemGroup>

</Project>
