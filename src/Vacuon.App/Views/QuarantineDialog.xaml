<Window x:Class="Vacuon.App.Views.QuarantineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Vacuon.App.Infra"
        Width="620" SizeToContent="Height"
        MinHeight="240" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Amber, like the move: this is the reversible action. The red badge belongs to
             the permanent delete, and the difference has to be readable at a glance. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                    Background="{DynamicResource Risk.Notable}">
                <TextBlock x:Name="ModeBadgeText" FontSize="10" FontWeight="Bold"
                           FontFamily="{StaticResource Font.Ui}" Foreground="White"/>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" Margin="10,0,0,0"
                       FontSize="17" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- The line that stops someone hunting for space that did not come back. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,9">
            <StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeldNote" Style="{StaticResource Text.Sub}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="BodyNote" Grid.Row="2" Style="{StaticResource Text.Sub}"
                   Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Secondary}"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0"
                MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <StackPanel>
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Path}" ToolTip="{Binding Path}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                               FontSize="11" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding SizeText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="MoreItems" Style="{StaticResource Text.Sub}" FontSize="11"
                               Margin="0,8,0,0" Foreground="{DynamicResource Text.Muted}"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                            Converter={StaticResource NotEmpty}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="NoticeBox" Grid.Row="4" CornerRadius="6" Padding="12" Margin="0,12,0,0"
                Background="{DynamicResource Accent.Muted}" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Base}"
                    MinWidth="104" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}"
                    MinWidth="104" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
