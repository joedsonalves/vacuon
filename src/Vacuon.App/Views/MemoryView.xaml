<UserControl x:Class="Vacuon.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <infra:InverseBoolToVisibilityConverter x:Key="NotVisible"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
        <infra:ShareToPercentConverter x:Key="SharePercent"/>
    </UserControl.Resources>

    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.memory.title}"/>

            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Muted}"
                       Text="{DynamicResource S.memory.intro}"/>

            <!-- Working set conta pagina compartilhada uma vez por processo. Somar isso nos
                 filhos de um navegador da mais memoria do que a maquina tem. -->
            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource Text.Muted}"
                       Text="{DynamicResource S.memory.honestyNote}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Padding="14,7"
                        Content="{DynamicResource S.action.inspect}"
                        Command="{Binding RunMemoryScanCommand}"/>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Muted}"
                           Text="{Binding MemoryStatusText}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                       Text="{Binding MemoryTotals}"
                       Visibility="{Binding MemoryTotals, Converter={StaticResource NotEmpty}}"/>

            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,6,0,0" FontSize="11"
                       Foreground="{DynamicResource Text.Muted}"
                       Text="{Binding MemoryCompressed}"
                       Visibility="{Binding MemoryCompressed, Converter={StaticResource NotEmpty}}"/>

            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"
                       Text="{DynamicResource S.memory.compressedNote}"
                       Visibility="{Binding MemoryCompressed, Converter={StaticResource NotEmpty}}"/>

            <!-- O unico ganho permanente desta tela mora em outra aba, e ela diz isso. -->
            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Risk.Notable}"
                       Text="{Binding MemoryStartupShare}"
                       Visibility="{Binding HasStartupShare, Converter={StaticResource Visible}}"/>
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding HasMemoryRun, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Text.Section}" Margin="0,0,0,8"
                       Text="{DynamicResource S.memory.topTitle}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MemoryRows}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Body}"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource Text.Sub}" Margin="10,0,0,0"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Risk.Notable}"
                                                   Text="{Binding StartupText}"
                                                   Visibility="{Binding IsFromStartup, Converter={StaticResource Visible}}"/>
                                    </StackPanel>

                                    <ProgressBar Height="3" Margin="0,5,0,0" Maximum="100"
                                                 Foreground="{DynamicResource Gauge.Fill}"
                                                 Background="{DynamicResource Gauge.Track}"
                                                 Value="{Binding Share, Mode=OneWay,
                                                         Converter={StaticResource SharePercent}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Number}"
                                               FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding SizeText}"/>

                                    <!-- Fechar joga fora o que nao estiver salvo, entao o botao
                                         pergunta duas vezes e o segundo diz o que se esta
                                         aceitando, em vez de so "OK". -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,3"
                                                Content="{Binding CloseText}"
                                                Foreground="{DynamicResource Risk.Danger}"
                                                Click="OnArmClose"
                                                Visibility="{Binding CanClose, Converter={StaticResource Visible}}"/>

                                        <Button Style="{StaticResource Button.Base}" FontSize="11" Padding="8,3"
                                                Content="{Binding ConfirmText}"
                                                Foreground="{DynamicResource Risk.Danger}"
                                                Click="OnConfirmClose"
                                                Visibility="{Binding IsArmed, Converter={StaticResource Visible}}"/>

                                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,3"
                                                Margin="4,0,0,0"
                                                Content="{Binding CancelText}"
                                                Click="OnCancelClose"
                                                Visibility="{Binding IsArmed, Converter={StaticResource Visible}}"/>

                                        <TextBlock Style="{StaticResource Text.Sub}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding ProtectedText}"
                                                   Visibility="{Binding IsProtected, Converter={StaticResource Visible}}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="10" Margin="0,4,0,0"
                                               HorizontalAlignment="Right" TextWrapping="Wrap"
                                               MaxWidth="260" TextAlignment="Right"
                                               Text="{Binding Outcome}"
                                               Visibility="{Binding Outcome, Converter={StaticResource NotEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ==================== o botao que os outros vendem ====================
                 Ele existe, e vem com a descricao real colada nele em vez do numero
                 sozinho. -->
            <Border Grid.Row="2" Margin="0,12,0,16" Padding="16,12" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.memory.trimExplain}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="12,6"
                                Foreground="{DynamicResource Risk.Danger}"
                                Content="{DynamicResource S.memory.trim}"
                                Command="{Binding TrimWorkingSetsCommand}"/>

                        <TextBlock Style="{StaticResource Text.Sub}" Margin="14,0,0,0" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding TrimOutcome}"
                                   Visibility="{Binding HasTrimOutcome, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" VerticalAlignment="Top" TextWrapping="Wrap"
                   Style="{StaticResource Text.Sub}" Foreground="{DynamicResource Text.Muted}"
                   Text="{DynamicResource S.memory.prompt}"
                   Visibility="{Binding HasMemoryRun, Converter={StaticResource NotVisible}}"/>
    </Grid>
</UserControl>
