<UserControl x:Class="Vacuon.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <!-- Every view declares its own: resources on MainWindow are not in scope here, and
             a missing one is a XamlParseException at load, which takes the whole window
             down rather than just this tab. -->
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                   MaxWidth="820" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="{DynamicResource S.dup.subtitle}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11">
            <StackPanel Orientation="Horizontal">
                <!-- A mesma pergunta em dois tamanhos: o arquivo e a pasta. Um backup feito
                     duas vezes sao quatro mil arquivos duplicados e UMA pasta duplicada. -->
                <RadioButton GroupName="dupmode" VerticalAlignment="Center" Margin="0,0,12,0"
                             IsChecked="{Binding DuplicatesByFile}"
                             Content="{DynamicResource S.dup.byFiles}"/>
                <RadioButton GroupName="dupmode" VerticalAlignment="Center" Margin="0,0,16,0"
                             IsChecked="{Binding DuplicatesByFolder}"
                             Content="{DynamicResource S.dup.byFolders}"/>

                <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                        Content="{DynamicResource S.dup.find}"
                        Command="{Binding FindDuplicatesCommand}"/>

                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.cancel}"
                        Click="OnStop"
                        Visibility="{Binding IsFindingDuplicates, Converter={StaticResource Visible}}"/>

                <!-- Ao lado do botão, e não no rodapé: é ali que a decisão de esperar é
                     tomada. Some sozinho quando já há o que lembrar. -->
                <Border CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource Accent.Muted}"
                        Visibility="{Binding HasDuplicateNotice, Converter={StaticResource Visible}}">
                    <TextBlock FontSize="11" TextWrapping="Wrap" MaxWidth="300"
                               FontFamily="{StaticResource Font.Ui}"
                               Text="{Binding DuplicateNotice}"/>
                </Border>

                <!-- The command existed and nothing was bound to it, so there was no way to
                     tick more than one copy at a time on a list thousands of groups long. -->
                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.selectAll}"
                        Command="{Binding SelectAllDuplicatesCommand}"
                        Visibility="{Binding HasDuplicateGroups, Converter={StaticResource Visible}}"/>

                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.clearAll}"
                        Command="{Binding ClearDuplicateSelectionCommand}"
                        Visibility="{Binding HasDuplicateGroups, Converter={StaticResource Visible}}"/>

                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap" MaxWidth="430"
                               Text="{Binding DuplicateStatusText}"/>

                    <!-- Thin on purpose: it sits under a line of text that already says the
                         two numbers, and it is there to show the shape of the wait, not to
                         compete with them. -->
                    <ProgressBar Height="3" Width="240" Margin="0,5,0,1"
                                 HorizontalAlignment="Left"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding DuplicateProgressValue, Mode=OneWay}"
                                 Background="{DynamicResource Surface.Input}"
                                 Foreground="{DynamicResource Accent}"
                                 BorderThickness="0"
                                 Visibility="{Binding HasDuplicateProgress,
                                              Converter={StaticResource Visible}}"/>
                    <!-- The worst case, said plainly, before a read that can take an hour. -->
                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap" MaxWidth="430"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding DuplicateScopeText}"
                               Visibility="{Binding DuplicateScopeText,
                                            Converter={StaticResource NotEmpty}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,13">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Text="{Binding HeaderText}"/>

                                <TextBlock Style="{StaticResource Text.Sub}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Text.Muted}"
                                           Text="{Binding NothingRecoverableNote}"
                                           Visibility="{Binding NothingRecoverableNote,
                                                        Converter={StaticResource NotEmpty}}"/>

                                <!-- Per group, because a group is the unit somebody decides
                                     about: everything here is one file under several names. -->
                                <Button Style="{StaticResource Button.Base}" FontSize="10"
                                        Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Content="{Binding SelectGroupLabel}"
                                        Click="OnSelectGroup"/>

                                <!-- The keeper. No checkbox exists for it, so no amount of
                                     clicking or "select all" can put it up for removal. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Accent.Muted}">
                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource Font.Ui}"
                                                   Text="{Binding KeeperLabel}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Sub}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Text="{Binding KeeperPath}"
                                               ToolTip="{Binding KeeperPath}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Copies}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,0,0">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          VerticalContentAlignment="Center">
                                                    <TextBlock Style="{StaticResource Text.Sub}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Path}"
                                                               ToolTip="{Binding Path}"/>
                                                </CheckBox>
                                                <TextBlock Style="{StaticResource Text.Sub}" FontSize="10"
                                                           Margin="24,1,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Risk.Notable}"
                                                           Text="{Binding HardLinkNote}"
                                                           Visibility="{Binding HardLinkNote,
                                                                        Converter={StaticResource NotEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== pastas idênticas (F4.8) ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                      Visibility="{Binding HasDuplicateFolders, Converter={StaticResource Visible}}">
            <ItemsControl ItemsSource="{Binding DuplicateFolderGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Text="{Binding HeaderText}"/>

                                <Button Style="{StaticResource Button.Base}" FontSize="10"
                                        Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Content="{Binding SelectGroupLabel}"
                                        Click="OnSelectFolderGroup"/>

                                <!-- A pasta que fica não tem checkbox nenhuma, como no
                                     modo de arquivos. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Accent.Muted}">
                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                   FontFamily="{StaticResource Font.Ui}"
                                                   Text="{Binding KeeperLabel}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Sub}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Text="{Binding KeeperPath}"
                                               ToolTip="{Binding KeeperPath}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Copies}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3,0,0"
                                                      VerticalContentAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Sub}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Path}"
                                                           ToolTip="{Binding Path}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="0,12,0,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Stroke.Subtle}"
                Visibility="{Binding HasDuplicateSelection, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                        Content="{DynamicResource S.dup.quarantineSelected}"
                        Click="OnQuarantineSelected"/>

                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.linkSelected}"
                        Click="OnLinkSelected"/>
                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.clearSelection}"
                        Command="{Binding ClearDuplicateSelectionCommand}"/>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding DuplicateSelectionText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
