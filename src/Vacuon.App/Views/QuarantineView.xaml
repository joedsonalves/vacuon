<UserControl x:Class="Vacuon.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- No title here: the window header already carries the section name, and every
             other view leaves it to do that. The screen exists to make one thing
             unmistakable, and that is the line below — this is not freed space. -->
        <TextBlock Grid.Row="0" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                   MaxWidth="760" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="{DynamicResource S.quarantine.subtitle}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="{Binding QuarantineStatusText}"/>
                <TextBlock Style="{StaticResource Text.Sub}" Margin="14,0,0,0" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                           Foreground="{DynamicResource Text.Muted}"
                           Text="{Binding QuarantineHeldText}"
                           Visibility="{Binding QuarantineHeldText, Converter={StaticResource NotEmpty}}"/>
                <Button Style="{StaticResource Button.Ghost}" Margin="16,0,0,0"
                        FontSize="11" Padding="8,4"
                        Content="{DynamicResource S.action.refresh}"
                        Command="{Binding RefreshQuarantineCommand}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding QuarantineBatches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                   Text="{Binding CountText}"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding HeldText}"/>
                                        <TextBlock Style="{StaticResource Text.Sub}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding AgeText}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,6,0,0"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding PreviewText}"/>

                                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,4,0,0"
                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding BatchId}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Style="{StaticResource Button.Primary}"
                                            FontSize="12" Padding="12,6" MinWidth="96"
                                            Content="{DynamicResource S.quarantine.restore}"
                                            Command="{Binding DataContext.RestoreBatchCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Red, because purging is the one step here with no undo. -->
                                    <Button Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                                            FontSize="12" Padding="12,6" MinWidth="96"
                                            Foreground="{DynamicResource Risk.Danger}"
                                            Content="{DynamicResource S.quarantine.purge}"
                                            Command="{Binding DataContext.PurgeBatchCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
