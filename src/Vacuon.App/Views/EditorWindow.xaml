<Window x:Class="Vacuon.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vacuon.App.Views"
        Width="900" Height="680" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnKeys">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="FindBox" Width="200" FontSize="11"
                             Style="{StaticResource Input}" KeyDown="OnFindKey"/>

                    <Button Style="{StaticResource Button.Base}" FontSize="10" Padding="8,3"
                            Margin="6,0,0,0"
                            Content="{DynamicResource S.edit.findNext}" Click="OnFindNext"/>

                    <TextBlock x:Name="FindStatus" Style="{StaticResource Text.Sub}"
                               FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" FontSize="11" Padding="12,4"
                            Content="{DynamicResource S.edit.save}"
                            Command="{Binding SaveEditCommand}"/>

                    <Button Style="{StaticResource Button.Base}" FontSize="11" Padding="10,4"
                            Margin="8,0,0,0"
                            Content="{DynamicResource S.edit.close}" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Surface.Input}"
                BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1">
            <views:CodeEditor x:Name="Editor"
                              Text="{Binding EditorText, Mode=TwoWay,
                                     UpdateSourceTrigger=PropertyChanged}"
                              FileName="{Binding PreviewTitle, Mode=OneWay}"
                              IsHex="{Binding IsEditingHex, Mode=OneWay}"
                              TextElement.FontFamily="{StaticResource Font.Mono}"
                              TextElement.FontSize="12"
                              TextElement.Foreground="{DynamicResource Text.Secondary}"
                              CaretBrush="{DynamicResource Text.Primary}"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Text.Sub}" FontSize="11" TextWrapping="Wrap"
                       Text="{Binding EditStatus}"/>

            <Button Style="{StaticResource Button.Base}" FontSize="10" Padding="8,3"
                    Margin="0,6,0,0" HorizontalAlignment="Left"
                    Content="{DynamicResource S.edit.watchForRelease}"
                    Command="{Binding WatchForReleaseCommand}"
                    Visibility="{Binding CanWatchForRelease, Converter={StaticResource Visible}}"/>
        </StackPanel>
    </Grid>
</Window>
