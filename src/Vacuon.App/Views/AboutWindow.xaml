<Window x:Class="Vacuon.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height"
        MinHeight="360" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" FontSize="20"/>
            <TextBlock x:Name="TaglineText" Style="{StaticResource Text.Sub}" Margin="0,4,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"/>
        </StackPanel>

        <!-- ==================== what is running ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
            <StackPanel>
                <TextBlock x:Name="BuildLabel" Style="{StaticResource Text.Sub}" FontSize="10"
                           Foreground="{DynamicResource Text.Muted}"/>
                <TextBlock x:Name="BuildText" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!--
            Three versions of the same app, compared here rather than left to the person: the
            build that is running, what winget believes is installed, and what the source has.
            They disagree on purpose in the window between a release and its manifest.
        -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
                <TextBlock x:Name="UpdateLabel" Style="{StaticResource Text.Sub}" FontSize="10"
                           Foreground="{DynamicResource Text.Muted}"/>

                <TextBlock x:Name="UpdateText" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="UpdateNote" Style="{StaticResource Text.Sub}" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}"/>

                <Border Background="{DynamicResource Surface.Input}" CornerRadius="6"
                        Padding="10,7" Margin="0,10,0,0">
                    <TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas" FontSize="12"
                             Foreground="{DynamicResource Text.Secondary}"
                             TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CheckButton" Style="{StaticResource Button.Base}"
                            Padding="12,6" Click="OnCheck"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource Button.Primary}"
                            Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="OnUpdate"/>
                </StackPanel>

                <CheckBox x:Name="AutoCheck" Style="{StaticResource Check}" Margin="0,12,0,0"
                          Checked="OnAutoCheckChanged" Unchecked="OnAutoCheckChanged"/>
            </StackPanel>
        </Border>

        <!-- ==================== the file on disk ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
                <TextBlock x:Name="FileLabel" Style="{StaticResource Text.Sub}" FontSize="10"
                           Foreground="{DynamicResource Text.Muted}"/>
                <TextBlock x:Name="FileText" Style="{StaticResource Text.Sub}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="HashText" Style="{StaticResource Text.Sub}" Margin="0,6,0,0"
                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <Button x:Name="HashButton" Style="{StaticResource Button.Base}"
                        HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" Click="OnHash"/>
            </StackPanel>
        </Border>

        <!-- Not in a horizontal StackPanel: that hands its children infinite width, so the
             wrapping never fires and the sentence is cut at the window edge instead. -->
        <TextBlock x:Name="LinksText" Grid.Row="4" Margin="0,14,0,0"
                   Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Muted}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ReleasesButton" Style="{StaticResource Button.Base}"
                    Padding="14,7" Click="OnReleases"/>
            <Button x:Name="CloseButton" Style="{StaticResource Button.Primary}"
                    Padding="14,7" Margin="8,0,0,0" IsDefault="True" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
