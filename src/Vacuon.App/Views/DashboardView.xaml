<UserControl x:Class="Vacuon.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <infra:GaugeBrushConverter x:Key="GaugeBrush"/>
        <infra:BytesConverter x:Key="Bytes"/>
        <infra:CountConverter x:Key="Count"/>
        <infra:InverseBoolToVisibilityConverter x:Key="InverseVisible"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel>

            <!-- ==================== volumes ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.volumes.title}"/>

            <ItemsControl ItemsSource="{Binding Volumes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="320" Margin="0,0,14,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Header}"/>
                                            <TextBlock Style="{StaticResource Text.Sub}" Margin="10,0,0,5"
                                                       VerticalAlignment="Bottom" Text="{Binding Label}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Text.Sub}" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding ScanHintText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Button.Base}"
                                            Content="{DynamicResource S.action.scan}" FontSize="12" Padding="10,5"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.ScanVolumeCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- barra de ocupação -->
                                <Border Height="8" CornerRadius="4" Margin="0,16,0,0"
                                        Background="{DynamicResource Gauge.Track}">
                                    <ProgressBar Height="8" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{Binding UsedPercent, Converter={StaticResource GaugeBrush}}"/>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}">
                                        <Run Text="{Binding UsedPercentText, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource S.volumes.used}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Sub}"
                                               Foreground="{DynamicResource Text.Secondary}">
                                        <Run Text="{Binding FreeText, Mode=OneWay}"/>
                                        <Run Text="{DynamicResource S.volumes.freeOf}"/>
                                        <Run Text="{Binding TotalText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>

                                <!--
                                    Tendência e projeção (F8.2). O texto nunca fica vazio:
                                    quando não há projeção, ele diz o motivo. Painel em
                                    branco parece defeito, e a razão é mais útil que uma
                                    data inventada.
                                -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,0,6,0"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding TrendArrow, Mode=OneWay}"/>
                                    <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                                               MaxWidth="250"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding TrendText, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==================== agregados ==================== -->
            <Grid Margin="0,14,0,0" Visibility="{Binding HasScanned, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- por tipo -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.dashboard.byType}"/>
                        <ItemsControl ItemsSource="{Binding Extensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row.Hover}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       Text="{Binding Extension}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Sub}"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       Text="{Binding Category}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Number}"
                                                       Text="{Binding TotalBytes, Converter={StaticResource Bytes}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- por tamanho -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.dashboard.bySize}"/>
                        <ItemsControl ItemsSource="{Binding SizeBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row.Hover}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                                       Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                                       Margin="0,0,12,0" Width="66"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       Text="{Binding Count, Converter={StaticResource Count}}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Number}" Width="72"
                                                       Text="{Binding TotalBytes, Converter={StaticResource Bytes}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- por idade -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.dashboard.byAge}"/>
                        <ItemsControl ItemsSource="{Binding AgeBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row.Hover}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                                       Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                                       Margin="0,0,12,0" Width="66"
                                                       Foreground="{DynamicResource Text.Muted}"
                                                       Text="{Binding Count, Converter={StaticResource Count}}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Number}" Width="72"
                                                       Text="{Binding TotalBytes, Converter={StaticResource Bytes}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== espaço que não é arquivo (F1.9) ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding HasSystemSpace, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="{Binding SystemSpaceTitle}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,4,0,8" TextWrapping="Wrap"
                               MaxWidth="820" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding SystemSpaceHint}"/>

                    <ItemsControl ItemsSource="{Binding SystemSpaceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                               Width="150" Text="{Binding Label}"/>

                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                               Width="86" Margin="0,0,14,0" Text="{Binding SizeText}"/>

                                    <!-- How it is dealt with, beside the number: none of these
                                         is removed the way a file is. -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Sub}"
                                               FontSize="11" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding HowText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== estado inicial ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="26"
                    Visibility="{Binding HasScanned, Converter={StaticResource InverseVisible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                               Text="{DynamicResource S.scan.nothingYet}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,8,0,0" TextWrapping="Wrap"
                               MaxWidth="760"
                               Text="{DynamicResource S.scan.nothingYetHint}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                               MaxWidth="760" Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.app.readOnlyNotice}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
