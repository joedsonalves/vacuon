<Window x:Class="Vacuon.App.Views.HexWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource Text.Title}"
                   FontSize="17" TextWrapping="Wrap"/>

        <TextBlock x:Name="PathText" Grid.Row="1" Style="{StaticResource Text.Sub}"
                   Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}"
                   FontSize="11" Foreground="{DynamicResource Text.Muted}"/>

        <!-- O mesmo enquadramento do "Apagar de vez": moldura de risco, texto que diz o que
             se perde, e o botão de confirmar desabilitado até a caixa ser marcada. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,11"
                BorderBrush="{DynamicResource Risk.Notable}" BorderThickness="1">
            <TextBlock x:Name="WarningText" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Risk.Notable}"/>
        </Border>

        <CheckBox x:Name="Understood" Grid.Row="3" Margin="0,14,0,0"
                  Checked="OnUnderstood" Unchecked="OnUnderstood"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Base}"
                    MinWidth="104" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}"
                    MinWidth="104" Margin="8,0,0,0" IsEnabled="False" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
