<UserControl x:Class="Vacuon.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <infra:EnumEqualsConverter x:Key="EnumEquals"/>
        <infra:InverseBoolToVisibilityConverter x:Key="InverseVisible"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- ==================== aparência ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.settings.appearance}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{DynamicResource S.settings.theme}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,4,0,12"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.settings.themeHint}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Theme" Style="{StaticResource Radio}" Content="{DynamicResource S.settings.themeDark}"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Dark, Mode=TwoWay}"/>
                        <RadioButton GroupName="Theme" Style="{StaticResource Radio}" Content="{DynamicResource S.settings.themeLight}" Margin="22,0,0,0"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Light, Mode=TwoWay}"/>
                        <RadioButton GroupName="Theme" Style="{StaticResource Radio}" Content="{DynamicResource S.settings.themeSystem}"
                                     Margin="22,0,0,0"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=System, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- ==================== idioma ==================== -->
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,22,0,0"
                               Text="{DynamicResource S.settings.language}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.settings.languageHint}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Language" Style="{StaticResource Radio}"
                                     Content="{DynamicResource S.settings.languageEnglish}"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=English, Mode=TwoWay}"/>
                        <RadioButton GroupName="Language" Style="{StaticResource Radio}" Margin="22,0,0,0"
                                     Content="{DynamicResource S.settings.languagePortuguese}"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Portuguese, Mode=TwoWay}"/>
                        <RadioButton GroupName="Language" Style="{StaticResource Radio}" Margin="22,0,0,0"
                                     Content="{DynamicResource S.settings.languageSystem}"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=System, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== privilégio ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Margin="0,22,0,8" Text="{DynamicResource S.settings.privilege}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Check}"
                              Content="{DynamicResource S.elevation.always}"
                              IsChecked="{Binding AlwaysRunAsAdministrator, Mode=TwoWay}"/>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="27,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding AlwaysAdminHintText}"/>

                    <Border Margin="27,14,0,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource Accent.Muted}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Text="{DynamicResource S.elevation.whyTitle}"/>
                            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Text="{DynamicResource S.elevation.whyBody}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="27,14,0,0"
                                Visibility="{Binding IsElevated, Converter={StaticResource InverseVisible}}">
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.action.restartElevatedNow}"
                                Command="{Binding RestartElevatedCommand}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="27,14,0,0"
                               Foreground="{DynamicResource Risk.Safe}"
                               Text="{DynamicResource S.elevation.alreadyElevated}"
                               Visibility="{Binding IsElevated, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </Border>

            <!-- ==================== miniaturas ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Margin="0,22,0,8" Text="{DynamicResource S.settings.thumbnails}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{DynamicResource S.settings.iconSize}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,4,0,10"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.settings.iconSizeHint}"/>
                    <ComboBox Width="260" HorizontalAlignment="Left"
                              ItemsSource="{Binding IconSizeOptions}"
                              SelectedItem="{Binding SelectedIconSizeOption}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="0,16,0,0"
                              Content="{DynamicResource S.settings.contentThumbs}"
                              IsChecked="{Binding ContentThumbnails, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="27,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.settings.contentThumbsHint}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="0,16,0,0"
                              Content="{DynamicResource S.settings.showHidden}"
                              IsChecked="{Binding ShowHiddenAndSystem, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- ==================== área de notificação ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Margin="0,22,0,8" Text="{DynamicResource S.settings.trayTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Check}"
                              Content="{DynamicResource S.settings.showTray}"
                              IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="0,16,0,0"
                              Content="{DynamicResource S.settings.notifyLow}"
                              IsChecked="{Binding NotifyOnLowSpace, Mode=TwoWay}"/>

                    <StackPanel Orientation="Horizontal" Margin="27,10,0,0">
                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Text="{DynamicResource S.settings.lowThreshold}"/>
                        <TextBox Width="70" Margin="10,0,6,0" TextAlignment="Right"
                                 AutomationProperties.Name="{DynamicResource S.settings.lowThreshold}"
                                 Text="{Binding LowSpaceThresholdGiB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}" Text="GiB"/>
                    </StackPanel>

                    <CheckBox Style="{StaticResource Check}" Margin="0,16,0,0"
                              Content="{DynamicResource S.settings.closeToTray}"
                              IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{DynamicResource S.settings.trayNote}"/>
                </StackPanel>
            </Border>

            <!-- ==================== o que esta versão faz ==================== -->
            <TextBlock Style="{StaticResource Text.Section}" Margin="0,22,0,8" Text="{DynamicResource S.settings.thisVersion}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                               Text="{Binding VersionTitleText}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource S.app.readOnlyNotice}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding PrivacyNoteText}"/>

                    <!-- Only rendered when there is a newer version; empty text draws nothing. -->
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Risk.Notable}"
                               Text="{Binding UpdateNoticeText}"/>

                    <Button Style="{StaticResource Button.Base}" HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,12,0,0" Click="OnAbout"
                            Content="{DynamicResource S.settings.about}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
