<UserControl x:Class="Vacuon.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Vacuon.App.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== seletor de painel ====================
             As duas telas moram juntas porque compartilham o que as separa do resto do
             app: em todo lugar o Vacuon le, e aqui ele escreve. -->
        <Border Grid.Row="0" Padding="24,14,24,0" BorderBrush="{DynamicResource Stroke.Subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Muted}"
                           Text="{DynamicResource S.optimize.intro}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,6,0">
                        <Button Style="{StaticResource Button.Ghost}" Padding="12,7" FontSize="13"
                                Content="{DynamicResource S.optimize.aiPanel}"
                                Click="OnShowAi"/>
                        <!-- Trilho de acento marca o painel ativo sem precisar de estilo novo -->
                        <Border Height="2" CornerRadius="1" Margin="4,2,4,0"
                                Background="{DynamicResource Gauge.Fill}"
                                Visibility="{Binding IsAiPanel, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <StackPanel>
                        <Button Style="{StaticResource Button.Ghost}" Padding="12,7" FontSize="13"
                                Content="{DynamicResource S.nav.startup}"
                                Click="OnShowStartup"/>
                        <Border Height="2" CornerRadius="1" Margin="4,2,4,0"
                                Background="{DynamicResource Gauge.Fill}"
                                Visibility="{Binding IsStartupPanel, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <views:AiView      Visibility="{Binding IsAiPanel,      Converter={StaticResource Visible}}"/>
            <views:StartupView Visibility="{Binding IsStartupPanel, Converter={StaticResource Visible}}"/>
        </Grid>
    </Grid>
</UserControl>
