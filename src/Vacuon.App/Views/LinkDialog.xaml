<Window x:Class="Vacuon.App.Views.LinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height"
        MinHeight="300" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource Text.Title}"
                   FontSize="17" TextWrapping="Wrap"/>

        <TextBlock x:Name="BodyText" Grid.Row="1" Style="{StaticResource Text.Body}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- The trade this makes, said before anybody agrees to it: two paths become one
             file, so writing through either changes what the other reads. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,11"
                BorderBrush="{DynamicResource Risk.Notable}" BorderThickness="1">
            <TextBlock x:Name="WarningText" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Risk.Notable}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10"
                MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PathList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap"
                                       Style="{StaticResource Text.Sub}" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="4" Style="{StaticResource Text.Sub}"
                   Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Muted}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Button.Base}"
                    MinWidth="104" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}"
                    MinWidth="104" Margin="8,0,0,0" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
