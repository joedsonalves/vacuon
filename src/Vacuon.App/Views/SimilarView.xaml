<UserControl x:Class="Vacuon.App.Views.SimilarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <!-- Declared here: window resources are not in a UserControl's scope, and a missing
             one is a XamlParseException that takes the whole app down at startup. -->
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                   MaxWidth="880" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="{DynamicResource S.similar.subtitle}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                        Content="{DynamicResource S.similar.find}"
                        Command="{Binding FindSimilarCommand}"/>

                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.cancel}" Click="OnStop"
                        Visibility="{Binding IsFindingSimilar, Converter={StaticResource Visible}}"/>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="760"
                           Text="{Binding SimilarStatusText}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SimilarGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,13">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Margin="0,0,0,10" Text="{Binding HeaderText}"/>

                                <!-- Side by side, because these files are genuinely
                                     different and the only way to agree they are the same
                                     picture is to look at them together. -->
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,12,10" Width="150">
                                                <StackPanel>
                                                    <Border Height="110" CornerRadius="4"
                                                            Background="{DynamicResource Surface.Input}">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="Uniform"
                                                               StretchDirection="DownOnly"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- The keeper gets a label, the others a
                                                         checkbox. There is no disabled tick
                                                         to click, so the version being kept
                                                         cannot be selected for removal. -->
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,6,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource Accent.Muted}"
                                                            Visibility="{Binding IsKeeper,
                                                                         Converter={StaticResource Visible}}">
                                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                                   FontFamily="{StaticResource Font.Ui}"
                                                                   Text="{DynamicResource S.similar.keeping}"/>
                                                    </Border>

                                                    <!-- Content is the same word on every
                                                         tile, so the name carries the file
                                                         and the tiles can be told apart. -->
                                                    <CheckBox Margin="0,6,0,0" IsChecked="{Binding IsChecked}"
                                                              AutomationProperties.Name="{Binding Name}"
                                                              Content="{DynamicResource S.similar.other}"
                                                              FontSize="11">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsKeeper}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                                               Margin="0,4,0,0" FontWeight="SemiBold"
                                                               Text="{Binding SizeText}"/>

                                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text.Muted}"
                                                               Text="{Binding Name}"
                                                               ToolTip="{Binding Path}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="0,12,0,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Stroke.Subtle}"
                Visibility="{Binding HasSimilarSelection, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                        Content="{DynamicResource S.similar.quarantineSelected}"
                        Click="OnQuarantineSelected"/>
                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.dup.clearSelection}"
                        Command="{Binding ClearSimilarSelectionCommand}"/>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding SimilarSelectionText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
