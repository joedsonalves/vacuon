<UserControl x:Class="Vacuon.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra"
             xmlns:views="clr-namespace:Vacuon.App.Views">

    <!-- Todo conversor usado aqui é declarado AQUI. Recurso da MainWindow não está no
         escopo de um UserControl, e usar um sem declarar derruba o app inteiro na
         abertura — o build passa, os testes passam, e o programa não abre. -->
    <UserControl.Resources>
        <infra:BytesConverter x:Key="Bytes"/>
        <infra:ShareToPercentConverter x:Key="SharePercent"/>
        <infra:CategoryBrushConverter x:Key="CategoryBrush"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
        <infra:InverseBoolToVisibilityConverter x:Key="InverseVisible"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== barra de ferramentas ==================== -->
        <Border Grid.Row="0" Padding="24,12" BorderBrush="{DynamicResource Stroke.Subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- modos + busca -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.biggestFiles}"
                                FontSize="12" Padding="10,6" Click="OnBiggestFiles"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.biggestFolders}" Margin="6,0,0,0"
                                FontSize="12" Padding="10,6" Click="OnBiggestFolders"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.suspicious}" Margin="6,0,0,0"
                                FontSize="12" Padding="10,6" Click="OnSuspicious"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Style="{StaticResource Input}" Margin="14,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                             ToolTip="{DynamicResource S.filter.searchPathHint}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.icon.label}"/>
                        <ComboBox Margin="8,0,0,0" Width="180"
                                  ItemsSource="{Binding IconSizeOptions}"
                                  SelectedItem="{Binding SelectedIconSizeOption}"
                                  ToolTip="{DynamicResource S.icon.hint}"/>
                    </StackPanel>
                </Grid>

                <!-- filtros -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.largerThan}"/>
                    <ComboBox Margin="7,0,0,0" Width="104" SelectedIndex="0" SelectionChanged="OnMinSizeChanged">
                        <ComboBoxItem Content="{DynamicResource S.filter.any}" Tag="0"/>
                        <ComboBoxItem Content="1 MB" Tag="1048576"/>
                        <ComboBoxItem Content="10 MB" Tag="10485760"/>
                        <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        <ComboBoxItem Content="500 MB" Tag="524288000"/>
                        <ComboBoxItem Content="1 GB" Tag="1073741824"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.notChangedFor}"/>
                    <ComboBox Margin="7,0,0,0" Width="104" SelectedIndex="0" SelectionChanged="OnMinAgeChanged">
                        <ComboBoxItem Content="{DynamicResource S.filter.any}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d30}" Tag="30"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d90}" Tag="90"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d180}" Tag="180"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.y1}" Tag="365"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.y2}" Tag="730"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.extension}"/>
                    <TextBox Style="{StaticResource Input}" Margin="7,0,0,0" Width="150"
                             Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="{DynamicResource S.filter.extensionHint}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="16,0,0,0" VerticalAlignment="Center"
                              Content="{DynamicResource S.filter.includeFolders}"
                              ToolTip="{DynamicResource S.filter.includeFoldersHint}"
                              IsChecked="{Binding SearchFolders, Mode=TwoWay}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="14,0,0,0" VerticalAlignment="Center"
                              Content="{DynamicResource S.filter.inSelectedFolder}"
                              IsChecked="{Binding SearchInSelectedFolder, Mode=TwoWay}"/>

                    <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" FontSize="12"
                            Content="{DynamicResource S.action.clear}" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== árvore + lista ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- árvore de pastas -->
            <Border Grid.Column="0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Text.Section}" Margin="6,0,0,6"
                               Text="{DynamicResource S.list.folderTree}"/>

                    <!-- Rolagem horizontal desabilitada de propósito: com ela ligada os
                         itens crescem além da viewport e a coluna de tamanho sai de vista. -->
                    <TreeView x:Name="Folders" Grid.Row="1" ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnFolderSelected"
                              PreviewMouseLeftButtonUp="OnFolderClick"
                              PreviewKeyDown="OnTreeKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- Sem largura fixa: com Width fixo os nós indentados
                                     empurravam a coluna de tamanho para fora da vista. -->
                                <Grid Margin="0,2,4,2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="60"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <!-- TreeView nao tem selecao multipla. Um checkbox por no
                                             deixa marcar varias pastas e apagar de uma vez.

                                             Grid, not a horizontal StackPanel. A StackPanel hands
                                             its children infinite width, so TextTrimming never
                                             fires: the name simply overflowed and the Grid column
                                             sliced it mid-glyph, with no ellipsis to say so. A
                                             starred column gives the TextBlock a real width, and
                                             "System Volume Info…" then admits it was shortened. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource Check}" Margin="0,0,6,0"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding FullPath}"/>
                                        </Grid>
                                        <!-- Barra de proporção: qual fatia do disco esta subárvore ocupa.
                                             Foreground explícito porque a cor herdada do TreeViewItem
                                             deixaria a barra cinza em vez de âmbar. -->
                                        <ProgressBar Height="3" Margin="0,4,0,1" Maximum="100"
                                                     Foreground="{DynamicResource Gauge.Fill}"
                                                     Background="{DynamicResource Gauge.Track}"
                                                     Value="{Binding ShareOfVolume, Mode=OneWay,
                                                             Converter={StaticResource SharePercent}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding SizeText}"/>
                                </Grid>
                                <HierarchicalDataTemplate.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </HierarchicalDataTemplate.ItemContainerStyle>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Stroke.Subtle}"/>

            <!-- lista de arquivos -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="{Binding ModeText}"/>

                    <!-- Marcar em lote. A cesta sobrevive a trocar de pasta, ordenar e
                         buscar, entao "selecionar tudo" aqui e o inicio de um lote, nao
                         uma selecao que morre no proximo clique. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                        <!-- Galeria (M3, F6.13). As linhas respondem "quanto ocupa"; a grade
                             responde "qual delas". Escolher entre quatro copias de uma foto
                             lendo quatro nomes de arquivo e o caso que isto existe para
                             resolver. -->
                        <ToggleButton Style="{StaticResource Toggle.Chip}"
                                      FontSize="11" Padding="8,4" Margin="0,0,10,0"
                                      Content="{DynamicResource S.preview.gallery}"
                                      AutomationProperties.Name="{DynamicResource S.preview.gallery}"
                                      IsChecked="{Binding IsGallery, Mode=TwoWay}"/>

                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4"
                                Content="{DynamicResource S.select.all}"
                                ToolTip="{DynamicResource S.select.allHint}"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Content="{DynamicResource S.select.invert}"
                                Command="{Binding InvertSelectionCommand}"/>
                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Content="{DynamicResource S.select.none}"
                                Command="{Binding ClearSelectionCommand}"
                                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Sub}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding TruncationText}"/>
                </Grid>

                <!-- Extended: Ctrl-click e Shift-click selecionam varios. SelectedItems nao
                     e bindavel no WPF, por isso a selecao vai ao VM pelo code-behind. -->
                <ListView x:Name="Files" Grid.Row="1" Style="{StaticResource FileList}"
                          Visibility="{Binding IsListMode, Converter={StaticResource Visible}}"
                          ItemsSource="{Binding Rows}"
                          ItemContainerStyle="{StaticResource FileRow}"
                          SelectionMode="Extended"
                          SelectionChanged="OnListSelectionChanged"
                          Margin="10,0,10,0"
                          SizeChanged="OnFileListSizeChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnRowDoubleClick"
                          PreviewKeyDown="OnListKeyDown"
                          PreviewMouseLeftButtonDown="OnListMouseDown"
                          MouseMove="OnListMouseMove"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <!-- Marcacao em lote. Fica antes de tudo porque e o que a pessoa
                                 clica em sequencia descendo a lista. -->
                            <GridViewColumn x:Name="CheckColumn" Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Named after the file, not "select": walking
                                             this list otherwise announces "checkbox" ninety
                                             times with nothing to tell the rows apart. -->
                                        <CheckBox Style="{StaticResource Check}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--
                                Ícone / miniatura: a largura acompanha o tamanho escolhido, mas
                                vem do code-behind (FitColumns), não de um Binding.

                                ⚠️ GridViewColumn é um Freezable e não está na árvore visual: o
                                Binding para IconPixels que ficava aqui não resolvia, a coluna
                                caía para largura automática e parava em ~52 px enquanto a célula
                                media 64. O ícone e a moldura de espera eram fatiados na vertical,
                                em toda linha, em todo tamanho de ícone.
                            -->
                            <GridViewColumn x:Name="IconColumn">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding DataContext.IconPixels,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Height="{Binding DataContext.IconPixels,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <!-- espaço reservado enquanto o Shell decodifica -->
                                            <Border CornerRadius="3" Background="{DynamicResource Surface.RowAlt}"
                                                    BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Cabecalhos vem do VM, com a seta de ordenacao ja embutida: o
                                 rotulo traduzido e a direcao sao uma string so, e mudam juntos.
                                 A Tag diz ao clique qual coluna foi pedida. -->
                            <GridViewColumn x:Name="NameColumn" Width="380">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Name"
                                               Text="{Binding DataContext.HeaderName,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}"
                                                       ToolTip="{Binding FullPath}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Width="6" Height="6" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                                <TextBlock Style="{StaticResource Text.Sub}" Margin="5,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           Text="{Binding DetailText}"/>
                                                <TextBlock Style="{StaticResource Text.Sub}" Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Risk.Notable}"
                                                           Text="{Binding Badges}"
                                                           Visibility="{Binding Badges, Converter={StaticResource NotEmpty}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--
                                ⚠️ Never give this cell a fixed Width again. Text.Number aligns
                                right, and a TextBlock that is 86 px wide by decree inside a cell
                                the presenter measured smaller keeps its 86 px and hangs its LEFT
                                edge outside the cell, where the clip lands. The leading digit went
                                with it: 63.8 GiB rendered as "53.8 GiB", 61.0 as "51.0", 6.5 as
                                "5.5" — a wrong number on screen, not a cosmetic trim.

                                Stretch plus TextAlignment gets the same right-hand alignment out
                                of a box that is whatever the cell actually is.
                            -->
                            <GridViewColumn x:Name="SizeColumn" Width="104">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Size"
                                               Text="{Binding DataContext.HeaderSize,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Number}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Right"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center" Text="{Binding SizeText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ModifiedColumn" Width="130">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Modified"
                                               Text="{Binding DataContext.HeaderModified,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                                   FontSize="11" Text="{Binding ModifiedText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="PathColumn" Width="420">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Path"
                                               Text="{Binding DataContext.HeaderPath,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding FullPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                    <ListView.ContextMenu>
                        <ContextMenu Opened="OnContextMenuOpened">
                            <MenuItem Header="{DynamicResource S.action.open}" Command="{Binding OpenCommand}"/>
                            <MenuItem Header="{DynamicResource S.action.reveal}" InputGestureText="Ctrl+Enter"
                                      Command="{Binding RevealCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.action.copyPath}" InputGestureText="Ctrl+C"
                                      Command="{Binding CopyPathCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.transfer.copyButton}" Click="OnCopyTo"/>
                            <MenuItem Header="{DynamicResource S.move.button}" Click="OnMoveTo"/>
                            <MenuItem Header="{DynamicResource S.compress.button}" Click="OnCompress"/>
                            <MenuItem Header="{DynamicResource S.shred.button}" Click="OnShred"/>
                            <MenuItem Header="{DynamicResource S.quarantine.button}" Click="OnQuarantine"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.select.all}" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="{DynamicResource S.select.invert}" Command="{Binding InvertSelectionCommand}"/>
                            <MenuItem Header="{DynamicResource S.select.none}" Command="{Binding ClearSelectionCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.delete.recycleHeader}" InputGestureText="Del"
                                      Click="OnDeleteToRecycleBin"/>
                            <MenuItem Header="{DynamicResource S.delete.permanentHeader}" InputGestureText="Shift+Del"
                                      Click="OnDeletePermanently"/>

                            <Separator/>

                            <!-- O menu do Windows entra DENTRO deste, não no lugar dele
                                 (M3, F6.10). O menu do Vacuon carrega a quarentena e o
                                 apagar que respeita a lista protegida; trocá-lo pelo do
                                 shell tiraria da mão da pessoa exatamente as ações que este
                                 programa existe para oferecer. -->
                            <MenuItem x:Name="ShellMenuItem"
                                      Header="{DynamicResource S.menu.windows}"
                                      Click="OnShowShellMenu"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>

                <!--
                    Modo galeria (M3, F6.13). Um ListBox separado em vez de trocar a View do
                    ListView em tempo de execução: cada controle virtualiza o seu, e só o
                    visível materializa linhas, então isto não custa memória enquanto está
                    escondido.
                -->
                <ListBox x:Name="Gallery" Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         SelectionMode="Extended"
                         SelectionChanged="OnGallerySelectionChanged"
                         MouseDoubleClick="OnRowDoubleClick"
                         Margin="10,0,10,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding IsGallery, Converter={StaticResource Visible}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="132" Margin="4" AutomationProperties.Name="{Binding Name}">
                                <Border Height="120" CornerRadius="4"
                                        Background="{DynamicResource Gauge.Track}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           StretchDirection="DownOnly"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Style="{StaticResource Text.Sub}" FontSize="10" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                           Text="{Binding Name}" ToolTip="{Binding FullPath}"/>
                                <TextBlock Style="{StaticResource Text.Sub}" FontSize="9"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted}"
                                           Text="{Binding LogicalSize, Converter={StaticResource Bytes}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>


                <!-- ações da seleção -->
                <StackPanel Grid.Row="2">
                    <!-- A Lixeira nao devolve espaco enquanto nao for esvaziada, entao o
                         app diz quanto continua ocupado em vez de somar como liberado. -->
                    <Border Padding="16,8" BorderBrush="{DynamicResource Stroke.Subtle}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding HasRecycled, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding RecycledText}"/>
                            <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0"
                                    FontSize="11" Padding="8,4"
                                    Content="{DynamicResource S.delete.openRecycleBin}"
                                    Command="{Binding OpenRecycleBinCommand}"/>
                        </StackPanel>
                    </Border>

                <Border Padding="16,10" BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                    <!-- WrapPanel, not a StackPanel: horizontally these buttons ran past the
                         pane and the last one read "Quarant". A destructive action half off
                         the screen is worse than one on a second line. -->
                    <WrapPanel Orientation="Horizontal" ItemHeight="34">
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.action.open}" Command="{Binding OpenCommand}"/>
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.action.reveal}" Command="{Binding RevealCommand}"/>
                            <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.action.copyPath}" Command="{Binding CopyPathCommand}"/>

                        <Border Width="1" Margin="14,2" Background="{DynamicResource Stroke.Subtle}"/>

                        <!-- Copiar e mover ficam entre a divisoria e a de apagar: sao as
                             unicas acoes em lote que nao destroem nada, e nao devem encostar
                             no botao vermelho. Copiar vem primeiro por ser a mais inofensiva
                             das duas — nao tira nada de onde estava. -->
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.transfer.copyButton}"
                                ToolTip="{DynamicResource S.transfer.copyButtonHint}"
                                Click="OnCopyTo"/>

                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.move.button}"
                                ToolTip="{DynamicResource S.move.buttonHint}"
                                Click="OnMoveTo"/>

                        <Border Width="1" Margin="14,2" Background="{DynamicResource Stroke.Subtle}"/>

                        <!-- Quarentena antes da Lixeira e do apagar: e a acao de remocao que
                             tem volta, e o PRD quer ela como o caminho padrao. -->
                        <!-- Antes da quarentena e do apagar, porque e a acao que devolve
                             espaco sem tirar nada de ninguem. -->
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.compress.button}"
                                ToolTip="{DynamicResource S.compress.buttonHint}"
                                Click="OnCompress"/>

                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.quarantine.button}"
                                ToolTip="{DynamicResource S.quarantine.buttonHint}"
                                Click="OnQuarantine"/>

                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.delete.recycle}" Click="OnDeleteToRecycleBin"/>
                        <!-- Vermelho no permanente: a cor de risco e o sinal mais rapido de
                             que este botao nao tem volta. -->
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Foreground="{DynamicResource Risk.Danger}"
                                Content="{DynamicResource S.delete.permanent}" Click="OnDeletePermanently"/>

                        <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Text="{Binding SelectionSummaryText}"/>

                        <TextBlock Style="{StaticResource Text.Sub}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                   Text="{DynamicResource S.select.keepsAcrossFolders}"
                                   Visibility="{Binding HasBasket, Converter={StaticResource Visible}}"/>
                    </WrapPanel>
                </Border>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Preview: answers "what IS this?" about the file under the cursor, which is
                 the question standing between someone and deleting it. Everything shown
                 here is the first 64 KiB, or metadata Windows already had. -->
            <Border Grid.Column="4" Padding="12,10" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource Stroke.Subtle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Text.Section}" Margin="0,0,0,8"
                               Text="{DynamicResource S.preview.title}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Text="{Binding PreviewTitle}" ToolTip="{Binding PreviewTitle}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding HasPreviewImage, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Text.Sub}" FontSize="10" Margin="6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding PreviewZoomText}"/>

                            <Button Style="{StaticResource Button.Ghost}" FontSize="10" Padding="7,3"
                                    Content="{DynamicResource S.preview.fit}"
                                    Click="OnPreviewFit"/>

                            <ToggleButton Style="{StaticResource Toggle.Chip}"
                                          Margin="5,0,0,0" FontSize="10" Padding="7,3"
                                          Content="{DynamicResource S.preview.compare}"
                                          IsChecked="{Binding IsComparing, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Media facts. For a video this IS the preview: no frame is decoded,
                         and 2160p against 720p is what decides which copy stays. -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding PreviewFacts, Converter={StaticResource NotEmpty}}">
                        <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                   TextWrapping="Wrap" Text="{Binding PreviewFacts}"/>
                    </Border>

                    <Grid Grid.Row="3">
                        <!-- Uma prévia, ou duas lado a lado (F6.14). A comparação existe
                             para a pergunta que a lista não responde: destas duas cópias,
                             qual é a melhor? -->
                        <Grid Visibility="{Binding IsComparing, Converter={StaticResource InverseVisible}}">
                            <views:ZoomableImage x:Name="PreviewZoom"
                                                 Source="{Binding PreviewImageSource}"
                                                 Visibility="{Binding HasPreviewImage, Converter={StaticResource Visible}}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding PreviewText, Converter={StaticResource NotEmpty}}">
                                <views:SyntaxTextBlock SourceText="{Binding PreviewText, Mode=OneWay}"
                                                       FileName="{Binding PreviewTitle, Mode=OneWay}"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                                       TextWrapping="NoWrap"/>
                            </ScrollViewer>

                            <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{DynamicResource S.preview.pickOne}"
                                       Visibility="{Binding HasNoPreviewTarget,
                                                    Converter={StaticResource Visible}}"/>
                        </Grid>

                        <Grid Visibility="{Binding IsComparing, Converter={StaticResource Visible}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <views:ZoomableImage Grid.Row="0" Source="{Binding PreviewImageSource}"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource Text.Sub}" FontSize="10"
                                       Margin="0,6" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding CompareCaption}"/>

                            <views:ZoomableImage Grid.Row="2" Source="{Binding CompareImageSource}"
                                                 Visibility="{Binding HasCompareTarget, Converter={StaticResource Visible}}"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource Text.Sub}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{DynamicResource S.preview.comparePickSecond}"
                                       Visibility="{Binding HasCompareTarget, Converter={StaticResource InverseVisible}}"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="4" Style="{StaticResource Text.Sub}" FontSize="10"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding PreviewNote}"
                               Visibility="{Binding PreviewNote, Converter={StaticResource NotEmpty}}"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
