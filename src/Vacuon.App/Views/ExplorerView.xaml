<UserControl x:Class="Vacuon.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <infra:BytesConverter x:Key="Bytes"/>
        <infra:ShareToPercentConverter x:Key="SharePercent"/>
        <infra:CategoryBrushConverter x:Key="CategoryBrush"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== barra de ferramentas ==================== -->
        <Border Grid.Row="0" Padding="24,12" BorderBrush="{DynamicResource Stroke.Subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- modos + busca -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.biggestFiles}"
                                FontSize="12" Padding="10,6" Click="OnBiggestFiles"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.biggestFolders}" Margin="6,0,0,0"
                                FontSize="12" Padding="10,6" Click="OnBiggestFolders"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource S.filter.suspicious}" Margin="6,0,0,0"
                                FontSize="12" Padding="10,6" Click="OnSuspicious"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Style="{StaticResource Input}" Margin="14,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                             ToolTip="{DynamicResource S.filter.searchHint}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.icon.label}"/>
                        <ComboBox Margin="8,0,0,0" Width="180"
                                  ItemsSource="{Binding IconSizeOptions}"
                                  SelectedItem="{Binding SelectedIconSizeOption}"
                                  ToolTip="{DynamicResource S.icon.hint}"/>
                    </StackPanel>
                </Grid>

                <!-- filtros -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.largerThan}"/>
                    <ComboBox Margin="7,0,0,0" Width="104" SelectedIndex="0" SelectionChanged="OnMinSizeChanged">
                        <ComboBoxItem Content="{DynamicResource S.filter.any}" Tag="0"/>
                        <ComboBoxItem Content="1 MB" Tag="1048576"/>
                        <ComboBoxItem Content="10 MB" Tag="10485760"/>
                        <ComboBoxItem Content="100 MB" Tag="104857600"/>
                        <ComboBoxItem Content="500 MB" Tag="524288000"/>
                        <ComboBoxItem Content="1 GB" Tag="1073741824"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.notChangedFor}"/>
                    <ComboBox Margin="7,0,0,0" Width="104" SelectedIndex="0" SelectionChanged="OnMinAgeChanged">
                        <ComboBoxItem Content="{DynamicResource S.filter.any}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d30}" Tag="30"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d90}" Tag="90"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.d180}" Tag="180"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.y1}" Tag="365"/>
                        <ComboBoxItem Content="{DynamicResource S.filter.y2}" Tag="730"/>
                    </ComboBox>

                    <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}" Text="{DynamicResource S.filter.extension}"/>
                    <TextBox Style="{StaticResource Input}" Margin="7,0,0,0" Width="150"
                             Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             ToolTip="{DynamicResource S.filter.extensionHint}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="16,0,0,0" VerticalAlignment="Center"
                              Content="{DynamicResource S.filter.includeFolders}"
                              ToolTip="{DynamicResource S.filter.includeFoldersHint}"
                              IsChecked="{Binding SearchFolders, Mode=TwoWay}"/>

                    <CheckBox Style="{StaticResource Check}" Margin="14,0,0,0" VerticalAlignment="Center"
                              Content="{DynamicResource S.filter.inSelectedFolder}"
                              IsChecked="{Binding SearchInSelectedFolder, Mode=TwoWay}"/>

                    <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" FontSize="12"
                            Content="{DynamicResource S.action.clear}" Command="{Binding ClearFiltersCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== árvore + lista ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- árvore de pastas -->
            <Border Grid.Column="0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Text.Section}" Margin="6,0,0,6"
                               Text="{DynamicResource S.list.folderTree}"/>

                    <!-- Rolagem horizontal desabilitada de propósito: com ela ligada os
                         itens crescem além da viewport e a coluna de tamanho sai de vista. -->
                    <TreeView x:Name="Folders" Grid.Row="1" ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnFolderSelected"
                              PreviewKeyDown="OnTreeKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- Sem largura fixa: com Width fixo os nós indentados
                                     empurravam a coluna de tamanho para fora da vista. -->
                                <Grid Margin="0,2,4,2" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="60"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <!-- TreeView nao tem selecao multipla. Um checkbox por no
                                             deixa marcar varias pastas e apagar de uma vez. -->
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Style="{StaticResource Check}" Margin="0,0,6,0"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                        </StackPanel>
                                        <!-- Barra de proporção: qual fatia do disco esta subárvore ocupa.
                                             Foreground explícito porque a cor herdada do TreeViewItem
                                             deixaria a barra cinza em vez de âmbar. -->
                                        <ProgressBar Height="3" Margin="0,4,0,1" Maximum="100"
                                                     Foreground="{DynamicResource Gauge.Fill}"
                                                     Background="{DynamicResource Gauge.Track}"
                                                     Value="{Binding ShareOfVolume, Mode=OneWay,
                                                             Converter={StaticResource SharePercent}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Number}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Muted}"
                                               Text="{Binding SizeText}"/>
                                </Grid>
                                <HierarchicalDataTemplate.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </HierarchicalDataTemplate.ItemContainerStyle>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Stroke.Subtle}"/>

            <!-- lista de arquivos -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,10,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="{Binding ModeText}"/>

                    <!-- Marcar em lote. A cesta sobrevive a trocar de pasta, ordenar e
                         buscar, entao "selecionar tudo" aqui e o inicio de um lote, nao
                         uma selecao que morre no proximo clique. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4"
                                Content="{DynamicResource S.select.all}"
                                ToolTip="{DynamicResource S.select.allHint}"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Content="{DynamicResource S.select.invert}"
                                Command="{Binding InvertSelectionCommand}"/>
                        <Button Style="{StaticResource Button.Ghost}" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                                Content="{DynamicResource S.select.none}"
                                Command="{Binding ClearSelectionCommand}"
                                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Sub}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Muted}"
                               Text="{Binding TruncationText}"/>
                </Grid>

                <!-- Extended: Ctrl-click e Shift-click selecionam varios. SelectedItems nao
                     e bindavel no WPF, por isso a selecao vai ao VM pelo code-behind. -->
                <ListView x:Name="Files" Grid.Row="1" Style="{StaticResource FileList}"
                          ItemsSource="{Binding Rows}"
                          ItemContainerStyle="{StaticResource FileRow}"
                          SelectionMode="Extended"
                          SelectionChanged="OnListSelectionChanged"
                          Margin="10,0,10,0"
                          MouseDoubleClick="OnRowDoubleClick"
                          PreviewKeyDown="OnListKeyDown"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <!-- Marcacao em lote. Fica antes de tudo porque e o que a pessoa
                                 clica em sequencia descendo a lista. -->
                            <GridViewColumn Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Check}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Ícone / miniatura: a largura acompanha o tamanho escolhido -->
                            <GridViewColumn Width="{Binding IconPixels, Mode=OneWay}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding DataContext.IconPixels,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Height="{Binding DataContext.IconPixels,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <!-- espaço reservado enquanto o Shell decodifica -->
                                            <Border CornerRadius="3" Background="{DynamicResource Surface.RowAlt}"
                                                    BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Cabecalhos vem do VM, com a seta de ordenacao ja embutida: o
                                 rotulo traduzido e a direcao sao uma string so, e mudam juntos.
                                 A Tag diz ao clique qual coluna foi pedida. -->
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Name"
                                               Text="{Binding DataContext.HeaderName,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}"
                                                       ToolTip="{Binding FullPath}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Width="6" Height="6" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                                <TextBlock Style="{StaticResource Text.Sub}" Margin="5,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Muted}"
                                                           Text="{Binding DetailText}"/>
                                                <TextBlock Style="{StaticResource Text.Sub}" Margin="8,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Risk.Notable}"
                                                           Text="{Binding Badges}"
                                                           Visibility="{Binding Badges, Converter={StaticResource NotEmpty}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="96">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Size"
                                               Text="{Binding DataContext.HeaderSize,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Number}" Width="86"
                                                   VerticalAlignment="Center" Text="{Binding SizeText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="130">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Modified"
                                               Text="{Binding DataContext.HeaderModified,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                                   FontSize="11" Text="{Binding ModifiedText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="420">
                                <GridViewColumn.Header>
                                    <TextBlock Tag="Path"
                                               Text="{Binding DataContext.HeaderPath,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   Text="{Binding FullPath}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource S.action.open}" Command="{Binding OpenCommand}"/>
                            <MenuItem Header="{DynamicResource S.action.reveal}" InputGestureText="Ctrl+Enter"
                                      Command="{Binding RevealCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.action.copyPath}" InputGestureText="Ctrl+C"
                                      Command="{Binding CopyPathCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.move.button}" Click="OnMoveTo"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.select.all}" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="{DynamicResource S.select.invert}" Command="{Binding InvertSelectionCommand}"/>
                            <MenuItem Header="{DynamicResource S.select.none}" Command="{Binding ClearSelectionCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource S.delete.recycleHeader}" InputGestureText="Del"
                                      Click="OnDeleteToRecycleBin"/>
                            <MenuItem Header="{DynamicResource S.delete.permanentHeader}" InputGestureText="Shift+Del"
                                      Click="OnDeletePermanently"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>

                <!-- ações da seleção -->
                <StackPanel Grid.Row="2">
                    <!-- A Lixeira nao devolve espaco enquanto nao for esvaziada, entao o
                         app diz quanto continua ocupado em vez de somar como liberado. -->
                    <Border Padding="16,8" BorderBrush="{DynamicResource Stroke.Subtle}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding HasRecycled, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Sub}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Text="{Binding RecycledText}"/>
                            <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0"
                                    FontSize="11" Padding="8,4"
                                    Content="{DynamicResource S.delete.openRecycleBin}"
                                    Command="{Binding OpenRecycleBinCommand}"/>
                        </StackPanel>
                    </Border>

                <Border Padding="16,10" BorderBrush="{DynamicResource Stroke.Subtle}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.action.open}" Command="{Binding OpenCommand}"/>
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.action.reveal}" Command="{Binding RevealCommand}"/>
                            <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Content="{DynamicResource S.action.copyPath}" Command="{Binding CopyPathCommand}"/>

                        <Border Width="1" Margin="14,2" Background="{DynamicResource Stroke.Subtle}"/>

                        <!-- Mover fica entre a divisoria e a de apagar: e a unica acao em
                             lote que nao destroi nada, e nao deve encostar no botao vermelho. -->
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.move.button}"
                                ToolTip="{DynamicResource S.move.buttonHint}"
                                Click="OnMoveTo"/>

                        <Border Width="1" Margin="14,2" Background="{DynamicResource Stroke.Subtle}"/>

                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6"
                                Content="{DynamicResource S.delete.recycle}" Click="OnDeleteToRecycleBin"/>
                        <!-- Vermelho no permanente: a cor de risco e o sinal mais rapido de
                             que este botao nao tem volta. -->
                        <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="7,0,0,0"
                                Foreground="{DynamicResource Risk.Danger}"
                                Content="{DynamicResource S.delete.permanent}" Click="OnDeletePermanently"/>

                        <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Text="{Binding SelectionSummaryText}"/>

                        <TextBlock Style="{StaticResource Text.Sub}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                   Text="{DynamicResource S.select.keepsAcrossFolders}"
                                   Visibility="{Binding HasBasket, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
