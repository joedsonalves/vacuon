<UserControl x:Class="Vacuon.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Vacuon.App.Infra">

    <UserControl.Resources>
        <!-- Declared here, not on MainWindow: window resources are not in a UserControl's
             scope, and a missing one is a XamlParseException that takes the whole app down
             at startup rather than just this tab. That already happened once. -->
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
        <infra:ResourceKeyToBrushConverter x:Key="BrushKey"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Text.Sub}" TextWrapping="Wrap"
                   MaxWidth="880" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="{DynamicResource S.cleanup.subtitle}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                            Content="{DynamicResource S.cleanup.scan}"
                            Command="{Binding ScanForJunkCommand}"/>

                    <Border Width="1" Margin="14,2" Background="{DynamicResource Stroke.Subtle}"/>

                    <!-- The profile is the risk gate, so it sits next to the scan button
                         rather than buried: Quick runs only what regenerates by itself. -->
                    <RadioButton GroupName="profile" VerticalAlignment="Center"
                                 Content="{DynamicResource S.cleanup.profileQuick}"
                                 IsChecked="{Binding IsQuickProfile, Mode=OneWay}"
                                 Checked="OnProfileQuick"/>
                    <RadioButton GroupName="profile" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Content="{DynamicResource S.cleanup.profileDeep}"
                                 IsChecked="{Binding IsDeepProfile, Mode=OneWay}"
                                 Checked="OnProfileDeep"/>
                    <RadioButton GroupName="profile" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Content="{DynamicResource S.cleanup.profileCustom}"
                                 IsChecked="{Binding IsCustomProfile, Mode=OneWay}"
                                 Checked="OnProfileCustom"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="0,10,0,0" TextWrapping="Wrap"
                           MaxWidth="880" Text="{Binding CleanupStatusText}"
                           Visibility="{Binding CleanupStatusText, Converter={StaticResource NotEmpty}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CleanupCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                <TextBlock Style="{StaticResource Text.Section}" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource Text.Sub}" Margin="10,0,0,0"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted}"
                                           Text="{Binding SummaryText}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,7" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Named after the rule: a column of
                                                     unnamed ticks cannot be used without sight. -->
                                                <CheckBox Grid.Column="0" VerticalAlignment="Top"
                                                          Margin="0,2,10,0"
                                                          AutomationProperties.Name="{Binding Name}"
                                                          IsChecked="{Binding IsChecked}"
                                                          IsEnabled="{Binding CanRun}"/>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Text.Body}"
                                                                   FontWeight="SemiBold" Text="{Binding Name}"/>
                                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding RiskBrush,
                                                                             Converter={StaticResource BrushKey}}">
                                                            <TextBlock FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       FontFamily="{StaticResource Font.Ui}"
                                                                       Text="{Binding RiskLabel}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Description}"/>

                                                    <!-- A tool rule states plainly that the gain
                                                         is only known after it has run. -->
                                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Text.Muted}"
                                                               Text="{Binding ToolText}"
                                                               Visibility="{Binding ToolText,
                                                                            Converter={StaticResource NotEmpty}}"/>

                                                    <TextBlock Style="{StaticResource Text.Sub}" FontSize="11"
                                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Risk.Notable}"
                                                               Text="{Binding SkipText}"
                                                               Visibility="{Binding SkipText,
                                                                            Converter={StaticResource NotEmpty}}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Number}"
                                                           FontSize="12" Margin="14,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding SizeText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="0,12,0,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Stroke.Subtle}"
                Visibility="{Binding HasCleanupSelection, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <!-- Reversible first and primary; permanent last and red. -->
                <Button Style="{StaticResource Button.Primary}" FontSize="12" Padding="12,6"
                        Content="{DynamicResource S.cleanup.toQuarantine}" Click="OnQuarantine"/>
                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Content="{DynamicResource S.cleanup.toRecycle}" Click="OnRecycle"/>
                <Button Style="{StaticResource Button.Base}" FontSize="12" Padding="10,6" Margin="8,0,0,0"
                        Foreground="{DynamicResource Risk.Danger}"
                        Content="{DynamicResource S.cleanup.toPermanent}" Click="OnPermanent"/>

                <TextBlock Style="{StaticResource Text.Sub}" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding CleanupSelectionText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
