<Window x:Class="Vacuon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Vacuon.App.Infra"
        xmlns:views="clr-namespace:Vacuon.App.Views"
        xmlns:vm="clr-namespace:Vacuon.App.ViewModels"
        Title="Vacuon" Height="820" Width="1360"
        MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Window}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <infra:InverseBoolToVisibilityConverter x:Key="NotVisible"/>
        <infra:EmptyStringToVisibilityConverter x:Key="NotEmpty"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}"/>
        <KeyBinding Key="Return" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding RevealCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyPathCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== barra lateral ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource Surface.Sidebar}"
                BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- marca -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,18,22">
                    <Canvas Width="26" Height="26" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="4"  Canvas.Top="4"  Width="18" Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                   Fill="{DynamicResource Accent}" Opacity="0.45"/>
                        <Rectangle Canvas.Left="6.5" Canvas.Top="8" Width="13" Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                   Fill="{DynamicResource Accent}" Opacity="0.72"/>
                        <Rectangle Canvas.Left="9"  Canvas.Top="12" Width="8"  Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                   Fill="{DynamicResource Accent}"/>
                        <Path Fill="{DynamicResource Accent}" Data="M 6,16.5 L 20,16.5 L 13,25 Z"/>
                    </Canvas>
                    <TextBlock Text="Vacuon" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold"
                               FontFamily="{StaticResource Font.Ui}"
                               Foreground="{DynamicResource Text.Primary}"/>
                </StackPanel>

                <!-- navegação -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavItem}" Content="{DynamicResource S.nav.dashboard}" Tag=""
                                 IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                 Checked="OnNavDashboard"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{DynamicResource S.nav.explorer}" Tag=""
                                 IsChecked="{Binding IsExplorer, Mode=OneWay}"
                                 Checked="OnNavExplorer"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{DynamicResource S.nav.security}" Tag=""
                                 IsChecked="{Binding IsSecurity, Mode=OneWay}"
                                 Checked="OnNavSecurity"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="{DynamicResource S.nav.settings}" Tag=""
                                 IsChecked="{Binding IsSettings, Mode=OneWay}"
                                 Checked="OnNavSettings"/>
                </StackPanel>

                <!-- resumo do volume varrido -->
                <StackPanel Grid.Row="2" Margin="18,26,18,0"
                            Visibility="{Binding HasScanned, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Text.Section}" Text="{DynamicResource S.scan.currentTitle}"/>
                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                               Text="{Binding SelectedVolume.Header}"/>
                    <TextBlock Style="{StaticResource Text.Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding SummaryText}"/>
                </StackPanel>

                <!-- estado de elevação -->
                <Border Grid.Row="3" Margin="12" Padding="12" CornerRadius="8"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Risk.Safe}"
                                       Visibility="{Binding IsElevated, Converter={StaticResource Visible}}"/>
                            <TextBlock Text="" FontFamily="{StaticResource Font.Icon}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Muted}"
                                       Visibility="{Binding IsElevated, Converter={StaticResource NotVisible}}"/>
                            <TextBlock Margin="7,0,0,0" Style="{StaticResource Text.Sub}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{DynamicResource S.elevation.elevated}"
                                       Visibility="{Binding IsElevated, Converter={StaticResource Visible}}"/>
                            <TextBlock Margin="7,0,0,0" Style="{StaticResource Text.Sub}"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{DynamicResource S.elevation.notElevated}"
                                       Visibility="{Binding IsElevated, Converter={StaticResource NotVisible}}"/>
                        </StackPanel>

                        <Button Style="{StaticResource Button.Base}" Margin="0,10,0,0"
                                Content="{DynamicResource S.action.restartElevated}"
                                FontSize="12" Padding="8,6"
                                Command="{Binding RestartElevatedCommand}"
                                Visibility="{Binding IsElevated, Converter={StaticResource NotVisible}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== conteúdo ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- cabeçalho -->
            <Border Grid.Row="0" Padding="24,16" BorderBrush="{DynamicResource Stroke.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Style="{StaticResource Text.Title}" Text="{DynamicResource S.nav.dashboard}"/>
                        <TextBlock Style="{StaticResource Text.Sub}" Margin="0,3,0,0"
                                   Text="{Binding StatusText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" FontSize="15"
                                FontFamily="{StaticResource Font.Icon}"
                                Content="{Binding ThemeToggleGlyph}"
                                ToolTip="{Binding ThemeToggleTooltip}"
                                Click="OnToggleTheme"/>
                        <Button Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                                Content="{DynamicResource S.action.cancel}"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource Visible}}"/>
                        <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                                Content="{DynamicResource S.action.scanKey}"
                                Command="{Binding ScanCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- telas -->
            <Grid Grid.Row="1">
                <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}"/>
                <views:ExplorerView  Visibility="{Binding IsExplorer,  Converter={StaticResource Visible}}"/>
                <views:SecurityView  Visibility="{Binding IsSecurity,  Converter={StaticResource Visible}}"/>
                <views:SettingsView  Visibility="{Binding IsSettings,  Converter={StaticResource Visible}}"/>
            </Grid>

            <!-- rodapé -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- OneWay explícito: ProgressBar.Value liga TwoWay por padrão e
                         Progress é somente leitura. -->
                    <ProgressBar Height="3" VerticalAlignment="Top"
                                 Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                 IsIndeterminate="False"
                                 Visibility="{Binding IsScanning, Converter={StaticResource Visible}}"/>
                    <Grid Margin="24,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Sub}"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Text="{Binding SelectionDetailText}"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Sub}"
                                   Foreground="{DynamicResource Text.Muted}"
                                   Text="{Binding FooterText}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
