<!--
    Tema claro. Mesmas chaves do Dark.xaml, uma a uma — é o contrato que permite
    trocar o dicionário em runtime sem tocar em nenhuma View.

    Os matizes de risco foram reescolhidos, não apenas escurecidos: o verde #3FB950
    que funciona sobre fundo escuro não passa de 3:1 de contraste sobre branco.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- superfícies -->
    <SolidColorBrush x:Key="Surface.Window"    Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Surface.Sidebar"   Color="#ECEEF2"/>
    <SolidColorBrush x:Key="Surface.Card"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.CardHover" Color="#F0F2F6"/>
    <SolidColorBrush x:Key="Surface.Input"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.RowAlt"    Color="#F4F5F8"/>
    <SolidColorBrush x:Key="Surface.Selected"  Color="#FFEFD6"/>

    <!-- traços -->
    <SolidColorBrush x:Key="Stroke.Subtle"  Color="#DDE1E8"/>
    <SolidColorBrush x:Key="Stroke.Strong"  Color="#BEC5D1"/>

    <!-- texto -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#161A22"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#4E566B"/>
    <SolidColorBrush x:Key="Text.Muted"     Color="#798195"/>
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#231703"/>

    <!-- acento âmbar, um passo mais escuro para segurar contraste sobre branco -->
    <SolidColorBrush x:Key="Accent"        Color="#E07B00"/>
    <SolidColorBrush x:Key="Accent.Hover"  Color="#C46A00"/>
    <SolidColorBrush x:Key="Accent.Muted"  Color="#FFF1DC"/>

    <!-- escala de risco — reservada -->
    <SolidColorBrush x:Key="Risk.Safe"     Color="#1A7F37"/>
    <SolidColorBrush x:Key="Risk.Notable"  Color="#9A6700"/>
    <SolidColorBrush x:Key="Risk.Warning"  Color="#BC4C00"/>
    <SolidColorBrush x:Key="Risk.Danger"   Color="#CF222E"/>
    <SolidColorBrush x:Key="Risk.Blocked"  Color="#6E7781"/>

    <!-- barras de ocupação -->
    <SolidColorBrush x:Key="Gauge.Track"   Color="#E2E5EB"/>
    <SolidColorBrush x:Key="Gauge.Fill"    Color="#E07B00"/>
    <SolidColorBrush x:Key="Gauge.Critical" Color="#CF222E"/>

    <!-- categorias de arquivo -->
    <SolidColorBrush x:Key="Cat.Video"     Color="#8250DF"/>
    <SolidColorBrush x:Key="Cat.Image"     Color="#0969DA"/>
    <SolidColorBrush x:Key="Cat.Audio"     Color="#0E8A7B"/>
    <SolidColorBrush x:Key="Cat.Document"  Color="#4B5FD6"/>
    <SolidColorBrush x:Key="Cat.Archive"   Color="#B35B00"/>
    <SolidColorBrush x:Key="Cat.Code"      Color="#1A7F37"/>
    <SolidColorBrush x:Key="Cat.Disk"      Color="#CF222E"/>
    <SolidColorBrush x:Key="Cat.Binary"    Color="#8250DF"/>
    <SolidColorBrush x:Key="Cat.Log"       Color="#6E7781"/>
    <SolidColorBrush x:Key="Cat.Other"     Color="#656D7A"/>

</ResourceDictionary>
